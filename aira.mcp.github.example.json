{
  "servers": [
    {
      "name": "github",
      "requireApproval": false,
      "url": "https://api.githubcopilot.com/mcp/",
      "authTokenEnv": "AIRA_GITHUB_TOKEN",
      "headers": {
        "X-MCP-Readonly": "true",
        "X-MCP-Toolsets": "repos"
      },
      "tools": ["get_file_contents", "list_branches", "list_commits", "get_commit"],
      "timeoutMs": 30000
    }
  ]
}
