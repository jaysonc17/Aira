{
  "name": "aira",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "format": "prettier --ignore-path .prettierignore --write \"src/**/*.ts\"",
    "format:check": "prettier --ignore-path .prettierignore --check \"src/**/*.ts\"",
    "test": "node --import tsx --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run typecheck && npm test",
    "start": "tsx src/index.ts",
    "start:github": "node --import tsx scripts/start-github.mjs",
    "check:github": "node --import tsx scripts/check-github.mjs",
    "check:approval": "node --import tsx scripts/check-approval.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "openai": "^6.49.0"
  }
}
